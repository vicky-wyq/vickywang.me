          <div class="element">
            <%- include(`${templatePath}/shared/txt_title_l`, {
             title:'Balancing operational efficiency, discoverability, and legacy constraints',}) %>

            <h2 class="fontWeight100">I compared two ways to improve discoverability while preserving provider familiarity and respecting existing inventory logic.</h2>
          </div>
        </div>
      </div>


      <div class="Grid Grid--gutters Grid--cols-2">
        <div class="Grid-cell">
          <div class="element">

            <%- include(`${templatePath}/shared/txt_title_s`, {
                title:'Option 1 — Add a separate discovery surface',}) %>
            <img class="modal-target card2026" src="wireframe_opt1.png" alt="Option 1 — Add a separate discovery surface">

            <div class="marginLeft">
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Increased visibility of new categories',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Aligned with the original stakeholder request',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Required providers to leave inventory workflows',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Introduced another destination to manage',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Preserved the fragmented workflow structure',}) %>

            </div>



          </div>
        </div>

        <div class="Grid-cell">
          <div class="element">


            <%- include(`${templatePath}/shared/txt_title_s`, {
                title:'Option 2 — Integrate discovery into inventory management',}) %>
            <img class="modal-target card2026" src="wireframe_opt2.png" alt="Option 2 — Integrate discovery into inventory management">

            <div class="marginLeft">
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Combined editing and discovery into one operational flow',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Reduced interaction cost during routine inventory updates',}) %>

              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Surfaced listed and unlisted gear while providers were already managing inventory',}) %>
              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Supported ongoing maintenance without extra navigation',}) %>
            </div>


          </div>

        </div>
      </div>


      <div class="Grid Grid--gutters Grid--full Grid--gutter">
        <div class="Grid-cell">
