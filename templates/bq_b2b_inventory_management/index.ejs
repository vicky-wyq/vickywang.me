              <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'· Evolved the system toward lightweight visual category navigation, unified inventory surfaces, persistent filtering, inline editing, clearer drag-and-drop behavior, and integrated storefront visibility',}) %>
            </div>
          </div>
        </div>
      </div>
    </div>


