            <%- include(`${templatePath}/shared/txt_title_s`, {
                title:'Collaboration & tradeoffs:',}) %>
            <%- include(`${templatePath}/shared/txt_description_l`, {
                text:'The remaining design challenge was improving category visibility without disrupting existing provider behavior. We balanced legacy navigation patterns, provider familiarity, marketing preferences for visual category browsing, and engineering support for existing inventory logic.',}) %>
            <div class="marginLeft">
